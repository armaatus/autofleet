{
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)",
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(./scripts/fleet/env.sh:*)",
      "Bash(./scripts/fleet/fleet.sh:*)",
      "Bash(./scripts/fleet/stop.sh:*)",
      "Bash(./scripts/fleet/reap.sh:*)",
      "Bash(./scripts/fleet/await-review.sh:*)",
      "Bash(./scripts/fleet/answer-review.sh:*)",
      "Bash(./scripts/fleet/review-status.sh:*)",
      "Bash(./scripts/fleet/record-review.sh:*)",
      "Bash(./scripts/fleet/resolve-thread.sh:*)",
      "Bash(./scripts/fleet/issue-command.sh:*)",
      "Bash(python3 .github/scripts/merge_gate.py:*)",
      "Bash(orca worktree set:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell-parses.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
